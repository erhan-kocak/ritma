{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.test)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Bash(cat *.env)",
      "Bash(type *.env)",
      "Bash(more *.env)",
      "Bash(less *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(Get-Content *.env)",
      "PowerShell(Get-Content *.env)",
      "PowerShell(cat *.env)",
      "PowerShell(type *.env)"
    ]
  }
}
